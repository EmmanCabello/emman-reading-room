# Emman Reading Room - API configuration
PORT=4100
DATABASE_URL="file:./emman-archive.db"
JWT_SECRET="change-me-emman-reading-room"
CLIENT_ORIGIN="http://localhost:5173"

# Optional: enable the online Archival Research Curator. Without a key the
# offline rule-based planner answers instead.
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
