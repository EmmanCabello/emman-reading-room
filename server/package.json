{
  "name": "@emman/server",
  "private": true,
  "version": "1.0.0",
  "main": "dist/src/app.js",
  "prisma": {
    "schema": "src/data/schema.prisma",
    "seed": "tsx src/data/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "node dist/src/app.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "tsx scripts/wipeDatabase.ts && prisma migrate deploy && prisma generate && prisma db seed",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
